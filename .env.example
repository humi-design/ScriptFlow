# Flask Configuration
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key

# MySQL Database Configuration (from cPanel)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_cpanel_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=scriptflow_db

# Optional: Set your domain
DOMAIN_NAME=https://yourdomain.com
